# Core Backend API Base URL (accepts http://localhost:3001/api/v1 or http://localhost:3001/api/v1/search/meaning)
THAI_CONTEXT_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Full NestJS TTS endpoint
THAI_CONTEXT_TTS_API_URL=http://localhost:3001/api/v1/tts/synthesize
# Mock Mode switch (false = query live PostgreSQL & Microservices, true = client-side mock)
THAI_CONTEXT_USE_MOCK=false
NEXT_PUBLIC_USE_MOCK=false
