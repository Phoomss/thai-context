model ModernTermRelationship {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modernTermId       String      @map("modern_term_id") @db.Uuid
  targetTerm         String      @map("target_term") @db.VarChar(255)
  targetModernTermId String?     @map("target_modern_term_id") @db.Uuid
  relationshipType   String      @map("relationship_type") @db.VarChar(50) // 'SYNONYM', 'RELATED', 'OPPOSITE', 'FORMAL_ALTERNATIVE', 'INFORMAL_ALTERNATIVE', 'TECHNICAL_VARIANT', 'BORROWED_FORM', 'ABBREVIATION_OF'
  sourceType         String      @default("AI_INFERRED") @map("source_type") @db.VarChar(50) // 'OFFICIAL_DATA', 'COMMUNITY', 'AI_INFERRED'
  confidence         Decimal     @default(0.8500) @db.Decimal(5, 4)
  notes              String?     @db.Text
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  sourceModernTerm   ModernTerm  @relation("SourceModernTerm", fields: [modernTermId], references: [id], onDelete: Cascade)
  targetModernTerm   ModernTerm? @relation("TargetModernTerm", fields: [targetModernTermId], references: [id], onDelete: SetNull)

  @@index([modernTermId])
  @@index([targetTerm])
  @@map("modern_term_relationships")
}

model ModernTermSubmission {
