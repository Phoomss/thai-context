datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector, pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

model DictionarySource {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String              @unique @db.VarChar(50)
  name        String              @db.VarChar(255)
  publisher   String              @db.VarChar(255)
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  editions    DictionaryEdition[]

  @@map("dictionary_sources")
}

model DictionaryEdition {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String             @map("source_id") @db.Uuid
  editionCode     String             @unique @map("edition_code") @db.VarChar(50)
  editionYear     String             @map("edition_year") @db.VarChar(10)
  title           String             @db.VarChar(255)
  publicationDate DateTime?          @map("publication_date") @db.Date
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  source          DictionarySource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  wordEntries     WordEntry[]
  dialectEntries  DialectEntry[]
  searchEmbeddings SearchEmbedding[]

  @@map("dictionary_editions")
}

model PartOfSpeech {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @unique @db.VarChar(20)
  abbrThai    String       @unique @map("abbr_thai") @db.VarChar(20)
  nameThai    String       @map("name_thai") @db.VarChar(100)
  nameEnglish String?      @map("name_english") @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  definitions Definition[]

  @@map("parts_of_speech")
}

model Word {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  headword      String             @unique @db.VarChar(255)
  headwordClean String             @map("headword_clean") @db.VarChar(255)
  charLength    Int                @map("char_length")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  entries       WordEntry[]
  relationshipsAsSource WordRelationship[] @relation("SourceWord")
  relationshipsAsTarget WordRelationship[] @relation("TargetWord")
  feedback      SearchFeedback[]
  translations  WordTranslation[]
  signEntries   SignLanguageEntry[]
  signResources SignResource[]
  modernTerms   ModernTerm[]
  dialectEntries DialectEntry[]
  dialectRelationships DialectRelationship[]

  @@index([headword])
  @@index([headwordClean])
  @@map("words")
}

model WordEntry {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId         String             @map("word_id") @db.Uuid
  editionId      String             @map("edition_id") @db.Uuid
  pronunciation  String?            @db.VarChar(255)
  royalSequence  Int?               @map("royal_sequence")
  pageNumber     Int?               @map("page_number")
  metadata       Json?              @default("{}") @db.JsonB
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  word           Word               @relation(fields: [wordId], references: [id], onDelete: Cascade)
  edition        DictionaryEdition  @relation(fields: [editionId], references: [id], onDelete: Restrict)
  definitions    Definition[]
  semanticMappings SemanticMapping[]
  ragEvidences   RagEvidence[]
  pronunciations WordPronunciation[]

  @@unique([wordId, editionId], name: "uq_word_edition")
  @@index([wordId])
  @@index([editionId])
  @@map("word_entries")
}

model Definition {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId        String        @map("entry_id") @db.Uuid
  posId          String?       @map("pos_id") @db.Uuid
  senseOrder     Int           @default(1) @map("sense_order")
  definitionText String        @map("definition_text") @db.Text
  registerLevel  String?       @default("FORMAL") @map("register_level") @db.VarChar(50)
  subjectDomain  String?       @map("subject_domain") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  entry          WordEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  pos            PartOfSpeech? @relation(fields: [posId], references: [id], onDelete: SetNull)
  examples       Example[]
  ragEvidences   RagEvidence[]

  @@unique([entryId, senseOrder], name: "uq_entry_sense")
  @@index([entryId])
  @@index([posId])
  @@map("definitions")
}

model Example {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  definitionId       String     @map("definition_id") @db.Uuid
  exampleText        String     @map("example_text") @db.Text
  sourceAttribution  String?    @map("source_attribution") @db.VarChar(255)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  definition         Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("examples")
}

model DialectRegion {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String         @unique @db.VarChar(50)
  nameThai        String         @map("name_thai") @db.VarChar(100)
  type            String         @default("REGION") @map("type") @db.VarChar(50) // 'REGION', 'PROVINCE'
  parentRegionId  String?        @map("parent_region_id") @db.Uuid
  description     String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  entries         DialectEntry[] @relation("DialectEntryRegion")
  provinceEntries DialectEntry[] @relation("DialectEntryProvince")
  parentRegion    DialectRegion? @relation("RegionHierarchy", fields: [parentRegionId], references: [id], onDelete: SetNull)
  subRegions      DialectRegion[] @relation("RegionHierarchy")

  @@map("dialect_regions")
}

model DialectEntry {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId          String            @map("region_id") @db.Uuid
  editionId         String            @map("edition_id") @db.Uuid
  wordId            String?           @map("word_id") @db.Uuid
  provinceId        String?           @map("province_id") @db.Uuid
  dialectWord       String            @map("dialect_word") @db.VarChar(255)
  dialectWordClean  String            @map("dialect_word_clean") @db.VarChar(255)
  ipaPhonetic       String?           @map("ipa_phonetic") @db.VarChar(255)
  localMeaning      String            @map("local_meaning") @db.Text
  culturalNotes     String?           @map("cultural_notes") @db.Text
  province          String?           @db.VarChar(100)
  languageVariant   String?           @map("language_variant") @db.VarChar(100)
  partOfSpeech      String?           @map("part_of_speech") @db.VarChar(50)
  status            String            @default("OFFICIAL_SOURCE") @db.VarChar(50) // 'OFFICIAL_SOURCE', 'VERIFIED', 'EXTERNAL_SOURCE', 'AI_INFERRED', 'UNVERIFIED'
  context           String?           @db.VarChar(50) // 'FORMAL', 'NEUTRAL', 'INFORMAL', 'CONVERSATIONAL', 'LOCAL', 'TRADITIONAL', 'CULTURAL'
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  region            DialectRegion     @relation("DialectEntryRegion", fields: [regionId], references: [id], onDelete: Restrict)
  provinceRegion    DialectRegion?    @relation("DialectEntryProvince", fields: [provinceId], references: [id], onDelete: SetNull)
  edition           DictionaryEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  word              Word?             @relation(fields: [wordId], references: [id], onDelete: SetNull)
  semanticMappings  SemanticMapping[]
  definitions       DialectDefinition[]
  sources           DialectSource[]
  examples          DialectExample[]
  relationships     DialectRelationship[]

  @@index([regionId])
  @@index([editionId])
  @@index([wordId])
  @@index([provinceId])
  @@index([dialectWord])
  @@map("dialect_entries")
}

model DialectDefinition {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dialectEntryId  String         @map("dialect_entry_id") @db.Uuid
  definition      String         @db.Text
  definitionType  String         @default("SOURCE_DEFINED") @map("definition_type") @db.VarChar(50) // 'SOURCE_DEFINED', 'EDITOR_REVIEWED', 'AI_GENERATED'
  sourceId        String?        @map("source_id") @db.Uuid
  verified        Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  dialectEntry    DialectEntry   @relation(fields: [dialectEntryId], references: [id], onDelete: Cascade)
  source          DialectSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([dialectEntryId])
  @@map("dialect_definitions")
}

model DialectSource {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dialectEntryId     String              @map("dialect_entry_id") @db.Uuid
  sourceType         String              @map("source_type") @db.VarChar(50) // 'ROYAL_SOCIETY', 'ORGANIZER_DATA', 'DIALECT_DICTIONARY', 'RESEARCH_DATA', 'OPEN_DATA', 'EXTERNAL', 'DEMO'
  sourceName         String              @map("source_name") @db.VarChar(255)
  sourceUrl          String?             @map("source_url") @db.Text
  edition            String?             @db.VarChar(100)
  sourceDate         DateTime?           @map("source_date") @db.Date
  license            String?             @db.VarChar(100)
  verificationStatus String              @default("VERIFIED") @map("verification_status") @db.VarChar(50) // 'VERIFIED', 'OFFICIAL', 'EXTERNAL', 'UNVERIFIED', 'DEMO'
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  dialectEntry       DialectEntry        @relation(fields: [dialectEntryId], references: [id], onDelete: Cascade)
  definitions        DialectDefinition[]

  @@index([dialectEntryId])
  @@map("dialect_sources")
}

model DialectExample {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dialectEntryId    String       @map("dialect_entry_id") @db.Uuid
  exampleText       String       @map("example_text") @db.Text
  meaningTh         String?      @map("meaning_th") @db.Text
  contextNote       String?      @map("context_note") @db.Text
  sourceAttribution String?      @map("source_attribution") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  dialectEntry      DialectEntry @relation(fields: [dialectEntryId], references: [id], onDelete: Cascade)

  @@index([dialectEntryId])
  @@map("dialect_examples")
}

model DialectRelationship {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dialectEntryId   String       @map("dialect_entry_id") @db.Uuid
  targetType       String       @default("STANDARD_WORD") @map("target_type") @db.VarChar(50) // 'STANDARD_WORD', 'DIALECT_WORD', 'CONCEPT'
  targetId         String?      @map("target_id") @db.VarChar(255)
  standardWordId   String?      @map("standard_word_id") @db.Uuid
  relationshipType String       @map("relationship_type") @db.VarChar(50) // 'STANDARD_EQUIVALENT', 'MEANING_EQUIVALENT', 'RELATED', 'REGIONAL_VARIANT', 'SYNONYM', 'SIMILAR_MEANING', 'OPPOSITE', 'AI_INFERRED'
  confidenceScore  Decimal      @default(1.0000) @map("confidence_score") @db.Decimal(5, 4)
  notes            String?      @db.Text
  isInferred       Boolean      @default(false) @map("is_inferred")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  dialectEntry     DialectEntry @relation(fields: [dialectEntryId], references: [id], onDelete: Cascade)
  standardWord     Word?        @relation(fields: [standardWordId], references: [id], onDelete: SetNull)

  @@index([dialectEntryId])
  @@index([standardWordId])
  @@map("dialect_relationships")
}

model SemanticMapping {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standardEntryId  String       @map("standard_entry_id") @db.Uuid
  dialectEntryId   String       @map("dialect_entry_id") @db.Uuid
  relationshipType String       @map("relationship_type") @db.VarChar(50)
  confidenceScore  Decimal      @map("confidence_score") @db.Decimal(5, 4)
  sourceType       String       @map("source_type") @db.VarChar(50) // 'OFFICIAL_DATA' | 'AI_INFERRED'
  curatedBy        String?      @map("curated_by") @db.VarChar(100)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  standardEntry    WordEntry    @relation(fields: [standardEntryId], references: [id], onDelete: Cascade)
  dialectEntry     DialectEntry @relation(fields: [dialectEntryId], references: [id], onDelete: Cascade)

  @@unique([standardEntryId, dialectEntryId], name: "uq_std_dialect_map")
  @@index([standardEntryId])
  @@index([dialectEntryId])
  @@map("semantic_mappings")
}

model WordRelationship {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceWordId     String   @map("source_word_id") @db.Uuid
  targetWordId     String   @map("target_word_id") @db.Uuid
  relationshipType String   @map("relationship_type") @db.VarChar(50) // 'SYNONYM', 'ANTONYM', 'NEAR_SYNONYM'
  sourceType       String   @default("OFFICIAL_DATA") @map("source_type") @db.VarChar(50) // 'OFFICIAL_DATA' | 'AI_INFERRED'
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  sourceWord       Word     @relation("SourceWord", fields: [sourceWordId], references: [id], onDelete: Cascade)
  targetWord       Word     @relation("TargetWord", fields: [targetWordId], references: [id], onDelete: Cascade)

  @@index([sourceWordId])
  @@index([targetWordId])
  @@map("word_relationships")
}

model SearchEmbedding {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType     String             @map("entity_type") @db.VarChar(50) // 'WORD_ENTRY', 'DEFINITION', 'DIALECT_ENTRY'
  entityId       String             @map("entity_id") @db.Uuid
  editionId      String?            @map("edition_id") @db.Uuid
  searchableText String             @map("searchable_text") @db.Text
  modelName      String             @map("model_name") @db.VarChar(100)
  modelDimension Int                @default(1536) @map("model_dimension")
  embedding      Unsupported("vector(1536)")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  edition        DictionaryEdition? @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([entityType, editionId])
  @@map("search_embeddings")
}

model AiExplanation {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userQuery       String        @map("user_query") @db.Text
  explanationType String        @map("explanation_type") @db.VarChar(50) // 'MEANING_RECOMMEND', 'WORD_COMPARE', 'USAGE_GUIDANCE'
  generatedContent String       @map("generated_content") @db.Text
  modelIdentifier String        @map("model_identifier") @db.VarChar(100)
  temperature     Decimal?      @default(0.20) @db.Decimal(3, 2)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  evidences       RagEvidence[]

  @@map("ai_explanations")
}

model RagEvidence {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  explanationId  String        @map("explanation_id") @db.Uuid
  entryId        String        @map("entry_id") @db.Uuid
  definitionId   String?       @map("definition_id") @db.Uuid
  relevanceScore Decimal       @map("relevance_score") @db.Decimal(5, 4)
  citedSnippet   String        @map("cited_snippet") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  explanation    AiExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  entry          WordEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  definition     Definition?   @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([explanationId])
  @@index([entryId])
  @@map("rag_evidence")
}

model SearchFeedback {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryText         String    @map("query_text") @db.Text
  recommendedWordId String?   @map("recommended_word_id") @db.Uuid
  userAction        String    @map("user_action") @db.VarChar(50) // 'CLICK', 'COPY', 'THUMBS_UP', 'THUMBS_DOWN'
  rating            Int?      
  feedbackNotes     String?   @map("feedback_notes") @db.Text
  sessionId         String?   @map("session_id") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  word              Word?     @relation(fields: [recommendedWordId], references: [id], onDelete: SetNull)

  @@index([recommendedWordId])
  @@map("search_feedback")
}

model WordPronunciation {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId             String     @map("entry_id") @db.Uuid
  phoneticSpelling    String     @map("phonetic_spelling") @db.VarChar(255)
  transliterationRtgs String     @map("transliteration_rtgs") @db.VarChar(255)
  ipaNotation         String?    @map("ipa_notation") @db.VarChar(255)
  tonePattern         String?    @map("tone_pattern") @db.VarChar(100)
  sourceType          String     @default("OFFICIAL_DATA") @map("source_type") @db.VarChar(50) // 'OFFICIAL_DATA' | 'AI_INFERRED'
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  entry               WordEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("word_pronunciations")
}

model WordTranslation {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId                String   @map("word_id") @db.Uuid
  languageCode          String   @default("en") @map("language_code") @db.VarChar(10)
  translatedWord        String   @map("translated_word") @db.VarChar(255)
  contextualExplanation String?  @map("contextual_explanation") @db.Text
  provenance            String   @default("OFFICIAL_CURATED") @map("provenance") @db.VarChar(50) // 'OFFICIAL_CURATED' | 'AI_GENERATED' | 'COMMUNITY'
  confidenceScore       Decimal? @default(1.0000) @map("confidence_score") @db.Decimal(5, 4)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  word                  Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, languageCode])
  @@map("word_translations")
}

model SignLanguageEntry {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId               String        @map("word_id") @db.Uuid
  signName             String        @map("sign_name") @db.VarChar(255)
  handshapeDescription String?       @map("handshape_description") @db.Text
  dialectRegion        String        @default("CENTRAL") @map("dialect_region") @db.VarChar(50)
  verificationStatus   String        @default("VERIFIED") @map("verification_status") @db.VarChar(50) // 'OFFICIAL' | 'VERIFIED' | 'COMMUNITY' | 'AI_INFERRED'
  sourceAttribution    String?       @map("source_attribution") @db.VarChar(255)
  license              String?       @default("CC-BY-SA 4.0") @db.VarChar(100)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  word                 Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  mediaList            SignMedia[]

  @@index([wordId])
  @@map("sign_language_entries")
}

model SignMedia {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signId       String            @map("sign_id") @db.Uuid
  mediaType    String            @default("VIDEO_MP4") @map("media_type") @db.VarChar(50) // 'VIDEO_MP4' | 'GIF' | 'SVG'
  mediaUrl     String            @map("media_url") @db.Text
  thumbnailUrl String?           @map("thumbnail_url") @db.Text
  isPrimary    Boolean           @default(true) @map("is_primary")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  signEntry    SignLanguageEntry @relation(fields: [signId], references: [id], onDelete: Cascade)

  @@index([signId])
  @@map("sign_media")
}

model SignResource {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId             String   @map("word_id") @db.Uuid
  language           String   @default("THAI_SIGN_LANGUAGE") @db.VarChar(50)
  signName           String   @map("sign_name") @db.VarChar(255)
  representationType String   @default("MOTION") @map("representation_type") @db.VarChar(50) // 'MOTION' | 'SKELETON' | 'AVATAR' | 'EXTERNAL_VIDEO' | 'EXTERNAL_IMAGE'
  sourceType         String   @default("DEMO_DATA") @map("source_type") @db.VarChar(50) // 'AUTHORIZED_DATASET' | 'AUTHORIZED_PROVIDER' | 'USER_SUBMISSION' | 'EXTERNAL_RESOURCE' | 'DEMO_DATA'
  sourceUrl          String?  @map("source_url") @db.Text
  license            String?  @default("CC-BY-4.0") @db.VarChar(100)
  permissionStatus   String   @default("AUTHORIZED") @map("permission_status") @db.VarChar(50) // 'AUTHORIZED' | 'EXTERNAL_ONLY' | 'PENDING' | 'UNKNOWN'
  verificationStatus String   @default("VERIFIED") @map("verification_status") @db.VarChar(50) // 'VERIFIED' | 'PENDING_REVIEW' | 'REJECTED' | 'NOT_AVAILABLE'
  motionData         Json?    @map("motion_data") @db.JsonB
  metadata           Json?    @default("{}") @db.JsonB
  providerName       String?  @map("provider_name") @db.VarChar(255)
  verifiedBy         String?  @map("verified_by") @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  word               Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([verificationStatus])
  @@map("sign_resources")
}

model TtsCache {
  cacheKey         String   @id @map("cache_key") @db.VarChar(64) // SHA-256
  textContent      String   @map("text_content") @db.Text
  providerName     String   @map("provider_name") @db.VarChar(50)
  voiceId          String   @map("voice_id") @db.VarChar(100)
  audioStoragePath String   @map("audio_storage_path") @db.Text
  durationMs       Int?     @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("tts_cache")
}

model ModernTerm {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  term            String                   @db.VarChar(255)
  normalizedTerm  String                   @map("normalized_term") @db.VarChar(255)
  slug            String                   @unique @db.VarChar(255)
  language        String                   @default("th") @db.VarChar(10)
  termType        String                   @default("WORD") @map("term_type") @db.VarChar(50) // 'WORD', 'PHRASE', 'SLANG', 'ABBREVIATION', 'ACRONYM', 'BORROWED_WORD', 'TECHNICAL_TERM', 'INTERNET_TERM', 'PROPER_NOUN'
  status          String                   @default("COMMON") @map("status") @db.VarChar(50) // 'EMERGING', 'COMMON', 'TRENDING', 'SPECIALIZED', 'SLANG', 'TECHNICAL', 'BORROWED', 'ABBREVIATION', 'ACRONYM', 'BRAND_DERIVED', 'COMMUNITY_TERM'
  description     String?                  @db.Text
  origin          String                   @default("UNKNOWN") @map("origin") @db.VarChar(50) // 'THAI', 'ENGLISH_BORROWING', 'OTHER_LANGUAGE', 'INTERNET', 'SOCIAL_MEDIA', 'TECHNOLOGY', 'COMMUNITY', 'UNKNOWN'
  register        String?                  @default("NEUTRAL") @map("register") @db.VarChar(50) // 'FORMAL', 'SEMI_FORMAL', 'NEUTRAL', 'INFORMAL', 'SLANG', 'SPECIALIZED'
  audience        String?                  @default("GENERAL") @map("audience") @db.VarChar(50) // 'GENERAL', 'STUDENT', 'PROFESSIONAL', 'BUSINESS', 'TECHNICAL', 'SOCIAL_MEDIA', 'GAMING', 'ACADEMIC'
  firstSeenAt     DateTime?                @map("first_seen_at") @db.Date
  lastSeenAt      DateTime?                @map("last_seen_at") @db.Date
  sourceCount     Int                      @default(1) @map("source_count")
  confidence      Decimal                  @default(1.0000) @map("confidence") @db.Decimal(5, 4)
  isSearchable    Boolean                  @default(true) @map("is_searchable")
  officialWordId  String?                  @map("official_word_id") @db.Uuid
  transliteration String?                  @db.VarChar(255)
  englishMeaning  String?                  @map("english_meaning") @db.Text
  pronunciation   String?                  @db.VarChar(255)
  usageWarning    String?                  @map("usage_warning") @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  officialWord           Word?                     @relation(fields: [officialWordId], references: [id], onDelete: SetNull)
  sources                ModernTermSource[]
  definitions            ModernTermDefinition[]
  categories             ModernTermCategory[]
  examples               ModernTermExample[]
  relationshipsAsSource  ModernTermRelationship[]  @relation("SourceModernTerm")
  relationshipsAsTarget  ModernTermRelationship[]  @relation("TargetModernTerm")

  @@index([term])
  @@index([normalizedTerm])
  @@index([status])
  @@index([termType])
  @@index([origin])
  @@index([officialWordId])
  @@map("modern_terms")
}

model ModernTermSource {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modernTermId       String     @map("modern_term_id") @db.Uuid
  sourceType         String     @default("DEMO") @map("source_type") @db.VarChar(50) // 'OFFICIAL', 'PUBLIC_DATASET', 'COMMUNITY', 'EXTERNAL_SOURCE', 'USER_SUBMITTED', 'RESEARCH', 'DEMO', 'AI_GENERATED'
  sourceName         String     @map("source_name") @db.VarChar(255)
  sourceUrl          String?    @map("source_url") @db.Text
  sourceDate         String?    @map("source_date") @db.VarChar(50)
  excerpt            String?    @db.Text
  license            String?    @default("CC-BY-SA 4.0") @db.VarChar(100)
  verificationStatus String     @default("UNVERIFIED") @map("verification_status") @db.VarChar(50) // 'VERIFIED', 'UNVERIFIED', 'PENDING_REVIEW', 'REJECTED'
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz

  modernTerm         ModernTerm @relation(fields: [modernTermId], references: [id], onDelete: Cascade)

  @@index([modernTermId])
  @@index([sourceType])
  @@index([verificationStatus])
  @@map("modern_term_sources")
}

model ModernTermDefinition {
