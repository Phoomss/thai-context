# ==========================================
# 🇹🇭 THAI CONTEXT — Global Environment Setup
# ==========================================

# 1. Database Connection (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/thai_context"

# 2. AI Model Provider (Google Gemini 3.8 Flash)
GEMINI_API_KEY="your_gemini_api_key_here"

# (Optional Backup) OpenAI API Key
OPENAI_API_KEY="your_openai_api_key_here"

# 3. Backend Service Config
PORT=4000
NODE_ENV="development"

# 4. Frontend Service Config
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_USE_MOCK="false"
