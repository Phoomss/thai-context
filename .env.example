# Environment
NODE_ENV=development
PORT=3001

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/thai_context

# AI/NLP Microservice URL
AI_SERVICE_URL=http://localhost:8000

# LLM Configuration (Provider: local, gemini, openai)
LLM_PROVIDER=local
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding Configuration (Provider: local, gemini, openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536

# Retrieval & Ranking Parameters
SIMILARITY_THRESHOLD=0.65
TOP_K=10

# Hybrid Ranking Weights (Sum = 1.0)
WEIGHT_SEMANTIC=0.60
WEIGHT_KEYWORD=0.20
WEIGHT_CONTEXT=0.15
WEIGHT_SOURCE=0.05
