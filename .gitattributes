# Set default behavior to normalize line endings to LF
* text=auto eol=lf

# Force LF on scripts, dockerfiles, sql, source code to avoid CRLF issues in Linux containers and on Windows/macOS
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf
.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
